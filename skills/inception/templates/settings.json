{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash", "WebFetch", "WebSearch"],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git -C * push --force)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push -f)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * reset --hard)",
      "Bash(git -C * reset --hard *)",
      "Bash(git -C * clean -f*)",
      "Bash(git -C * branch -D *)",
      "Bash(git -C * checkout .)",
      "Bash(git -C * restore .)",
      "Bash(<STACK_DESTRUCTIVE_DB_COMMAND>)",
      "Bash(<STACK_DESTRUCTIVE_DB_COMMAND> *)"
    ]
  }
}
